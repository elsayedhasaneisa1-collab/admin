{
  "manifest_version": 3,
  "name": "Session Backup",
  "version": "1.4.0",
  "description": "Automatic session backup for your browser. Runs in the background.",
  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}